<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <View
        android:id="@+id/statusBarBackdrop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/brand_blue_dark" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/brand_blue"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/network_error_title"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/network_error_message"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- Sibling banner slot, sized between AdMob BANNER and LARGE_BANNER. Not overlaid on WebView. -->
    <FrameLayout
        android:id="@+id/partnerBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/banner_slot_bg"
        android:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="@color/banner_divider" />

        <ImageButton
            android:id="@+id/partnerBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/partner_banner_content_description"
            android:padding="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_dasom_01" />

        <TextView
            android:id="@+id/partnerBannerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:background="@color/banner_label_bg"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="@string/partner_banner_ad_label"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
